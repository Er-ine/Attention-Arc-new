{
  "name": "attention-arc",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}